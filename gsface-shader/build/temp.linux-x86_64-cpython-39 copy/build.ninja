ninja_required_version = 1.3
cxx = c++
nvcc = /opt/miniconda/envs/testenv/bin/nvcc

cflags = -pthread -B /opt/miniconda/envs/testenv/compiler_compat --sysroot=/ -I/usr/include/x86_64-linux-gnu -I/usr/include -Wl,--sysroot=/opt/miniconda/envs/testenv/x86_64-conda-linux-gnu/sysroot,--allow-shlib-undefined -fPIC -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include/TH -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include/THC -I/opt/miniconda/envs/testenv/include -I/opt/miniconda/envs/testenv/include/python3.9 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_gsface_shader -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include/TH -I/opt/miniconda/envs/testenv/lib/python3.9/site-packages/torch/include/THC -I/opt/miniconda/envs/testenv/include -I/opt/miniconda/envs/testenv/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_gsface_shader -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_75,code=compute_75 -gencode=arch=compute_75,code=sm_75 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/yanp/HeadAvatar/gsface-shader/build/temp.linux-x86_64-cpython-39/bindings.o: compile /home/yanp/HeadAvatar/gsface-shader/bindings.cpp
build /home/yanp/HeadAvatar/gsface-shader/build/temp.linux-x86_64-cpython-39/bruteforce_shader.o: cuda_compile /home/yanp/HeadAvatar/gsface-shader/bruteforce_shader.cu
build /home/yanp/HeadAvatar/gsface-shader/build/temp.linux-x86_64-cpython-39/etc.o: cuda_compile /home/yanp/HeadAvatar/gsface-shader/etc.cu






