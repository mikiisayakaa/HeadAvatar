ninja_required_version = 1.3
cxx = /usr/bin/g++-11
nvcc = /usr/local/cuda-11.8/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/yanp/miniconda3/envs/ga2/include -fPIC -O2 -isystem /home/yanp/miniconda3/envs/ga2/include -fPIC -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include/TH -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/yanp/miniconda3/envs/ga2/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_gsface_shader -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include/TH -I/home/yanp/miniconda3/envs/ga2/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/yanp/miniconda3/envs/ga2/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_gsface_shader -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -ccbin /usr/bin/gcc-11 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/yanp/HeadAvatar/gsface-shader/build/temp.linux-x86_64-cpython-310/bindings.o: compile /home/yanp/HeadAvatar/gsface-shader/bindings.cpp
build /home/yanp/HeadAvatar/gsface-shader/build/temp.linux-x86_64-cpython-310/bruteforce_shader.o: cuda_compile /home/yanp/HeadAvatar/gsface-shader/bruteforce_shader.cu
build /home/yanp/HeadAvatar/gsface-shader/build/temp.linux-x86_64-cpython-310/etc.o: cuda_compile /home/yanp/HeadAvatar/gsface-shader/etc.cu






